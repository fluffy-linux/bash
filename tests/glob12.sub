# Pathname expansion goes through glibc's glob(3).  What bash still does
# itself: pattern matching dequotes character class names, and compgen -G
# globs for completion.

# A character class name may be quoted; the matcher removes the
# backslashes, as a byte string and, when the string has a multibyte
# character, as a wide string.
for loc in C C.UTF-8
do
	export LC_ALL=$loc
	case a in [[:\al\pha:]]) echo "$loc: quoted class name matches" ;; *) echo "$loc: quoted class name does not match" ;; esac
	case a in [[:alpha\:]]) echo "$loc: trailing backslash matches" ;; *) echo "$loc: trailing backslash does not match" ;; esac
done
export LC_ALL=C.UTF-8
case éa in ?[[:\al\pha:]]) echo "wide: quoted class name matches" ;; *) echo "wide: quoted class name does not match" ;; esac
case éa in ?[[:alpha\:]]) echo "wide: trailing backslash matches" ;; *) echo "wide: trailing backslash does not match" ;; esac
export LC_ALL=C

TESTDIR=$TMPDIR/glob12-$$
mkdir $TESTDIR
builtin cd $TESTDIR || { echo $0: cannot cd to $TESTDIR >&2 ; exit 1; }
touch abc abd bcd .hidden

# compgen -G globs without quote removal, through the same flags.
compgen -G 'a*'
compgen -G '*'
shopt -s dotglob
compgen -G '*'
shopt -u dotglob
GLOBSORT=-name
compgen -G '*'
unset GLOBSORT
compgen -G 'z*'
echo "no match: status $?"

builtin cd /
rm -rf $TESTDIR
